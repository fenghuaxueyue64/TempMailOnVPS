# ──────────────────────────────────────────
# TempMail 环境变量配置（复制为 .env 使用）
# ──────────────────────────────────────────

# [应用]
NODE_ENV=production
HTTP_PORT=3000               # Bun HTTP 监听端口（仅内部）
SMTP_PORT=25                 # SMTP 监听端口
SMTP_NAME=mail.tmp.io        # SMTP Banner 显示的主机名
SMTP_MAX_CLIENTS=100         # 最大并发 SMTP 连接数

# [数据库]
DB_PATH=./data/db/tempmail.db
DB_CACHE_SIZE=-32000         # SQLite 缓存，单位 KB，负数表示 KB；32MB

# [认证]
JWT_SECRET=change-me-openssl-rand-hex-64
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=change-me-openssl-rand-hex-32   # 管理员登录换取 JWT 的密钥

# [域名] 逗号分隔，不加空格
ALLOWED_DOMAINS=tmp.io

# [deSEC.io] 多域名自动配置 MX
DESEC_TOKEN=
DESEC_AUTO_MX=false          # true 时添加新域名自动调用 deSEC API 配置 MX
VPS_IP=                      # VPS 公网 IP，用于自动创建 A 记录

# [邮箱]
DEFAULT_TTL_HOURS=24         # 新建邮箱默认存活时长（小时）
MAX_TTL_HOURS=168            # 单个邮箱最大存活时长（小时）
MAILBOX_TOKEN_BYTES=24       # 邮箱访问令牌随机字节数

# [附件]
ATT_DIR=./data/att
ATT_MAX_SIZE=10485760        # 单个附件最大 10MB（字节）

# [速率限制]
RATE_LIMIT_WINDOW=60         # 秒
RATE_LIMIT_MAX=120           # 窗口内最多请求数

# [Telegram Bot 通知（可选）]
TG_ENABLED=false             # true 时新邮件到达会推送通知
TG_BOT_TOKEN=                # 如 123456:ABC-DEF...
TG_DEFAULT_CHAT_ID=         # 接收通知的 chat id（数字）
